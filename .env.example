# Server only. Copy to .env.local locally, or configure a Sites/Tencent secret.
# Never prefix a secret with VITE_.
MIMO_API_KEY=
MIMO_MODEL=mimo-v2.6-flash

# H5 defaults to the same-origin /api/question-generate.
# Mini Program builds require an absolute HTTPS service endpoint here.
VITE_SHITI_AI_URL=
