[Unit]
Description=Shiti study notebook
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=shiti
Group=shiti
EnvironmentFile=/etc/shiti.env
Environment=GOMEMLIMIT=64MiB
Environment=GOGC=50
WorkingDirectory=/var/lib/shiti
RuntimeDirectory=shiti
RuntimeDirectoryMode=0755
ExecStart=/opt/shiti/current/shiti-server
ExecStartPost=/bin/sh -c 'test ! -f /var/lib/shiti/tunnel-url || cp /var/lib/shiti/tunnel-url /run/shiti/tunnel-url'
Restart=on-failure
RestartSec=3
MemoryLimit=104857600
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadOnlyDirectories=/opt/shiti
UMask=0077

[Install]
WantedBy=multi-user.target
